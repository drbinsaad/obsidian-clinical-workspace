{
  "name": "clinical-workspace",
  "version": "0.6.2",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "dev": "node esbuild.config.mjs --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts/*.mjs",
    "test": "node --import tsx --import ./tests/support/register.mjs --test tests/*.test.ts",
    "check": "npm run typecheck && npm run lint && npm run build && npm test",
    "version": "node scripts/version-bump.mjs && git add package.json manifest.json versions.json",
    "verify-release": "node scripts/verify-release.mjs",
    "verify-community": "node scripts/verify-community.mjs",
    "verify-assets": "node scripts/verify-public-assets.mjs",
    "review": "npm run check && npm run verify-release && npm run verify-community && npm run verify-assets",
    "install:vault": "node scripts/install-to-vault.mjs",
    "export:logbook": "node scripts/export-logbook.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.1",
    "globals": "^17.9.0",
    "jiti": "^2.7.0",
    "obsidian": "^1.8.7",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "yaml": "^2.9.0"
  },
  "description": "Mobile-first local clinical workflow for patients, care episodes, tasks and surgery logbook entries.",
  "author": {
    "name": "Ali Alshahrani",
    "url": "https://github.com/drbinsaad"
  },
  "license": "MIT",
  "homepage": "https://community.obsidian.md/plugins/clinical-workspace",
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "local-first",
    "clinical-workflow",
    "surgical-logbook",
    "typescript"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/drbinsaad/obsidian-clinical-workspace.git"
  },
  "bugs": {
    "url": "https://github.com/drbinsaad/obsidian-clinical-workspace/issues"
  },
  "main": "dist/main.js"
}
