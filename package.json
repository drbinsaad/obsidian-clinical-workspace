{
  "name": "clinical-workspace",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "dev": "node esbuild.config.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --import ./tests/support/register.mjs --test tests/*.test.ts",
    "check": "npm run typecheck && npm run build && npm test",
    "version": "node scripts/version-bump.mjs && git add package.json manifest.json versions.json",
    "verify-release": "node scripts/verify-release.mjs",
    "install:vault": "node scripts/install-to-vault.mjs",
    "import:noteplan": "node --import tsx --import ./tests/support/register.mjs tools/import-noteplan.ts",
    "import:shape": "node --import tsx --import ./tests/support/register.mjs tools/noteplan-shape.ts"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "js-yaml": "^5.2.3",
    "obsidian": "^1.8.7",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0"
  },
  "description": "Mobile-first local clinical workflow for patients, care episodes, tasks and surgery logbook entries.",
  "license": "MIT"
}
